#!/usr/bin/env fish
# vi: ft=fish

# Включает плагин Sentry для Claude Code только в личных репо. Глобально он
# выключен в dot_claude/modify_settings.json.tmpl, а здесь каждому репо из
# ~/Projects/{aimuzov,lazyvimx,aleshavpnov} и самим этим папкам дописывается
# enabledPlugins в .claude/settings.local.json: локальный скоуп перекрывает
# user. Идёт на каждый apply, чтобы подхватывать новые репо; остальные ключи
# файла не трогаются.

{{ if (eq .chezmoi.os "darwin") -}}

set -l mise "{{ .miseBinPath }}"
set -l plugin sentry@claude-plugins-official

# В кэше плагина может не быть; ставим в user-скоуп, а enabledPlugins там всё
# равно перепишет шаблон settings.json на false
if not $mise exec -- claude plugin list --json 2>/dev/null | $mise exec -- jq -e --arg id $plugin 'any(.[]; .id == $id)' >/dev/null
    $mise exec -- claude plugin install $plugin; or begin
        echo "sentry-plugin: install failed"
        exit 1
    end
end

# Сами корни тоже: в них открываются общие сессии сразу по всем проектам
set -l roots $HOME/Projects/{aimuzov,lazyvimx,aleshavpnov}
set -l targets
for root in $roots
    test -d $root; and set -a targets $root
end
for repo in $roots/*
    test -e $repo/.git; and set -a targets $repo
end

for repo in $targets
    set -l file $repo/.claude/settings.local.json
    set -l current '{}'
    if test -s $file
        if not $mise exec -- jq empty $file 2>/dev/null
            echo "sentry-plugin: $file is not valid JSON, skipped"
            continue
        end
        set current (cat $file | string collect)
    end

    set -l next (printf '%s' $current | $mise exec -- jq --arg id $plugin '.enabledPlugins[$id] = true' | string collect)
    if test "$next" = (printf '%s' $current | $mise exec -- jq . | string collect)
        continue
    end

    mkdir -p $repo/.claude
    printf '%s\n' $next >$file.tmp; and mv $file.tmp $file
end

{{ end -}}
