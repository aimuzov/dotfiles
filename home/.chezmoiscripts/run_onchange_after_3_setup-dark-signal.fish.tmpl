#!/usr/bin/env fish
# vi: ft=fish

# epoch-week: {{ div (now | unixEpoch) 604800 }}

# Собирает dark-signal из исходников, которые кладёт .chezmoiexternals/dark-signal.toml,
# и вешает LaunchAgent: при смене темы macOS всем запущенным nvim уходит SIGUSR1.
# Пересборка раз в неделю — синхронно с refreshPeriod у external.

{{ if (eq .chezmoi.os "darwin") -}}

set -l src $XDG_DATA_HOME/dark-signal

if not test -d $src
    echo "dark-signal: sources are missing, run chezmoi apply --refresh-externals"
    exit 0
end

cd $src; and swift build -c release; or begin
    echo "dark-signal: build failed"
    exit 1
end

mkdir -p $HOME/.bin
ln -sf $src/.build/release/dark-signal $HOME/.bin/dark-signal

# Предшественник этого агента жил в ~/Library/ThemeSwitcher и грузился из
# io.aimuzov.theme-switcher.plist; снимаем его, если он ещё на машине
launchctl bootout gui/(id -u)/io.aimuzov.theme-switcher 2>/dev/null
rm -f $HOME/Library/LaunchAgents/io.aimuzov.theme-switcher.plist
rm -rf $HOME/Library/ThemeSwitcher

$HOME/.bin/dark-signal install signal --process nvim

{{ end -}}
